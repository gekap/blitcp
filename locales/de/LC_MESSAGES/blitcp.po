msgstr "SMB durchsuchen"

msgid "Browse SMB share"
msgstr "SMB-Freigabe durchsuchen"

msgid "Check this destination against its manifest, without the source (--verify-manifest)"
msgstr "Dieses Ziel ohne die Quelle mit seinem Manifest prüfen (--verify-manifest)"

msgid "Checked again: all {n} files match the manifest"
msgstr "Erneut geprüft: alle {n} Dateien stimmen mit dem Manifest überein"

msgid "Checked again: {bad} of {n} files do not match"
msgstr "Erneut geprüft: {bad} von {n} Dateien stimmen nicht überein"

msgid "Checking against the manifest…"
msgstr "Prüfung gegen das Manifest…"

msgid "Choose destination folder"
msgstr "Zielordner wählen"

msgid "Copied, not verified"
msgstr "Kopiert, nicht geprüft"

msgid "Destination presets"
msgstr "Ziel-Vorlagen"

msgid "Destinations saved as {name}"
msgstr "Ziele gespeichert als {name}"

msgid "ETA {t}"
msgstr "Restzeit {t}"

msgid "ETA —"
msgstr "Restzeit —"

msgid "Failed: {why}"
msgstr "Fehlgeschlagen: {why}"

msgid "Incomplete: {f} failed, {r} refused"
msgstr "Unvollständig: {f} fehlgeschlagen, {r} abgelehnt"

msgid "Kept files that differ from the source"
msgstr "Dateien behalten, die von der Quelle abweichen"

msgid "Manifest: {where}"
msgstr "Manifest: {where}"

msgid "New connection…"
msgstr "Neue Verbindung…"

msgid "Not available with several destinations: {opts}"
msgstr "Mit mehreren Zielen nicht verfügbar: {opts}"

msgid "Not verified: the source changed during the copy"
msgstr "Nicht geprüft: die Quelle hat sich während des Kopierens geändert"

