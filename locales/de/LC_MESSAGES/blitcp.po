msgstr "dem Prozess sind die Dateideskriptoren ausgegangen ({err})"

msgid "{written} written · {skipped} skipped · {cloned} cloned · {linked} linked within run · {refused} refused · {failed} failed · {src} unreadable at the source"
msgstr "{written} geschrieben · {skipped} übersprungen · {cloned} geklont · {linked} innerhalb des Laufs verknüpft · {refused} abgelehnt · {failed} fehlgeschlagen · {src} an der Quelle nicht lesbar"

