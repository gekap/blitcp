msgstr "una cabecera pax mal formada"

msgid "Refused: the source host's archive holds {what} — stopped before it reached the destination"
msgstr "Rechazado: el archivo del host de origen contiene {what} — detenido antes de llegar al destino"

msgid "refused: {what}"
msgstr "rechazado: {what}"

msgid "not requested: the source host sent {what} in an earlier batch"
msgstr "no solicitado: el host de origen envió {what} en un lote anterior"

msgid "Error: the source host's archive holds {what} — stopped before it reached the destination"
msgstr "Error: el archivo del host de origen contiene {what} — detenido antes de llegar al destino"

