msgstr "un número negativo en una cabecera tar"

msgid "a tar header that is not a number"
msgstr "una cabecera tar que no es un número"

msgid "{path}: the folder changed after it was checked (it now leads outside the destination); nothing was written there"
msgstr "{path}: la carpeta cambió después de comprobarla (ahora lleva fuera del destino); no se escribió nada allí"

msgid "{rel}: {folder} is a symlink to {where}, outside the destination; nothing was written there"
msgstr "{rel}: {folder} es un enlace simbólico a {where}, fuera del destino; no se escribió nada allí"

