msgstr "κόλλησε — δείτε τις σημειώσεις"

msgid "{pct} % of {mbps} Mb/s"
msgstr "{pct} % από {mbps} Mb/s"

msgid "The source disk{dev} is the limit: it is busy {busy} and each write waits ~{ms} ms{ref}."
msgstr "Ο δίσκος πηγής{dev} είναι το όριο: είναι απασχολημένος {busy} και κάθε εγγραφή περιμένει ~{ms} ms{ref}."

msgid "The {tag}destination disk{dev} is the limit: it is busy {busy} and each read waits ~{ms} ms{ref}."
msgstr "Ο {tag}δίσκος προορισμού{dev} είναι το όριο: είναι απασχολημένος {busy} και κάθε ανάγνωση περιμένει ~{ms} ms{ref}."

msgid "{rate} · {f} / {t} files"
msgstr "{rate} · {f} / {t} αρχεία"

msgid "↑↓ notes"
msgstr "↑↓ σημειώσεις"

msgid "◀ limit: cpu"
msgstr "◀ όριο: cpu"

msgid "◀ limit: disk {pct} %"
msgstr "◀ όριο: δίσκος {pct} %"

msgid "◀ limit: network {mbps} Mb/s"
msgstr "◀ όριο: δίκτυο {mbps} Mb/s"

msgid "The small files finish first; no large file is started."
msgstr "Τα μικρά αρχεία ολοκληρώνονται πρώτα· κανένα μεγάλο αρχείο δεν ξεκινά."

msgid "Stopped: the copied files get their links, folders, records and sync…"
msgstr "Σταμάτησε: τα αντιγραμμένα αρχεία παίρνουν συνδέσμους, φακέλους, εγγραφές και συγχρονισμό…"

msgid "Stopping safely: the files in progress finish, what was copied gets its links, folders, records and sync, then blitcp exits."
msgstr "Ασφαλής διακοπή: τα τρέχοντα αρχεία ολοκληρώνονται, ό,τι αντιγράφηκε παίρνει συνδέσμους, φακέλους, εγγραφές και συγχρονισμό, και το blitcp τερματίζει."

msgid "size checked"
msgstr "ελέγχθηκε το μέγεθος"


msgid "owner {owner}, mode {mode}"
msgstr "ιδιοκτήτης {owner}, δικαιώματα {mode}"

msgid "local folder {path}"
msgstr "τοπικός φάκελος {path}"

msgid "{where}, folder {path}"
msgstr "{where}, φάκελος {path}"

msgid "shares there: {names}"
msgstr "κοινόχρηστοι φάκελοι εκεί: {names}"

msgid "SMB share {share} on {host}, folder {path}"
msgstr "κοινόχρηστος φάκελος SMB {share} στο {host}, φάκελος {path}"

msgid "{scheme} bucket {bucket}, prefix {prefix} (listed, nothing written)"
msgstr "{scheme} bucket {bucket}, πρόθεμα {prefix} (λίστα, τίποτα δεν γράφτηκε)"

msgid "no answer from {host} in {n} s: is it on, reachable, firewalled?"
msgstr "καμία απάντηση από το {host} σε {n} s: είναι ανοιχτό, προσβάσιμο, πίσω από τείχος προστασίας;"

msgid "folder not writable: {folder} ({detail}) — give {user} write access, or choose another folder"
msgstr "ο φάκελος δεν είναι εγγράψιμος: {folder} ({detail}) — δώστε στον {user} δικαίωμα εγγραφής ή επιλέξτε άλλο φάκελο"

msgid "cannot connect to {host}: {err}"
msgstr "δεν είναι δυνατή η σύνδεση στο {host}: {err}"

msgid "the host key could not be confirmed"
msgstr "το κλειδί του διακομιστή δεν επιβεβαιώθηκε"

msgid "cannot list {where}: {err}"
msgstr "δεν είναι δυνατή η λίστα του {where}: {err}"

msgid "OK — connected, folder writable: {what}"
msgstr "OK — συνδέθηκε, ο φάκελος είναι εγγράψιμος: {what}"

msgid "OK — connected, bucket listed: {what}"
msgstr "OK — συνδέθηκε, το bucket διαβάστηκε: {what}"

msgid "connection {name!r} has no valid type"
msgstr "η σύνδεση {name!r} δεν έχει έγκυρο τύπο"

msgid "{path} is not a folder"
msgstr "το {path} δεν είναι φάκελος"

msgid "{host} does not accept {proto} on port {port} — check the port"
msgstr "το {host} δεν δέχεται {proto} στη θύρα {port} — ελέγξτε τη θύρα"

msgid "cannot find host {host}: check its name"
msgstr "δεν βρέθηκε ο διακομιστής {host}: ελέγξτε το όνομα"

msgid "its shares could not be listed: {err}"
msgstr "οι κοινόχρηστοι φάκελοί του δεν μπόρεσαν να εμφανιστούν: {err}"

msgid "the share {share} is a path — a share is a name, not a path: set the share to {head} and put {rest} in the path"
msgstr "ο κοινόχρηστος φάκελος {share} είναι διαδρομή — ένας κοινόχρηστος φάκελος είναι όνομα, όχι διαδρομή: ορίστε ως κοινόχρηστο το {head} και βάλτε το {rest} στη διαδρομή"

msgid "share {share} not found on {host}; {shares}. If it is a folder, put it in the path"
msgstr "ο κοινόχρηστος φάκελος {share} δεν βρέθηκε στο {host}· {shares}. Αν είναι φάκελος, βάλτε τον στη διαδρομή"

msgid "{who} refused the login (user {user}). Set the user and password in this connection"
msgstr "το {who} απέρριψε τη σύνδεση (χρήστης {user}). Ορίστε χρήστη και κωδικό σε αυτή τη σύνδεση"

msgid "bucket {bucket} not found — check its name, and the region or account of this connection"
msgstr "το bucket {bucket} δεν βρέθηκε — ελέγξτε το όνομα και την περιοχή ή τον λογαριασμό αυτής της σύνδεσης"

msgid "access denied to bucket {bucket} — check the keys of this connection and what they may read"
msgstr "άρνηση πρόσβασης στο bucket {bucket} — ελέγξτε τα κλειδιά αυτής της σύνδεσης και τι επιτρέπεται να διαβάζουν"

msgid "the endpoint {endpoint} does not answer as a storage service — check the endpoint URL"
msgstr "το endpoint {endpoint} δεν απαντά ως υπηρεσία αποθήκευσης — ελέγξτε το URL του endpoint"

msgid "this connection has no host"
msgstr "αυτή η σύνδεση δεν έχει διακομιστή"

msgid "access denied"
msgstr "άρνηση πρόσβασης"

msgid "cannot check {dest}: {err}"
msgstr "δεν είναι δυνατός ο έλεγχος του {dest}: {err}"

msgid "this connection has no share; {shares}"
msgstr "αυτή η σύνδεση δεν έχει κοινόχρηστο φάκελο· {shares}"

msgid "this connection has no default bucket: test it as {name}:BUCKET in a run, or set one with: blitcp creds edit {name}"
msgstr "αυτή η σύνδεση δεν έχει προεπιλεγμένο bucket: δοκιμάστε την ως {name}:BUCKET σε μια εκτέλεση ή ορίστε ένα με: blitcp creds edit {name}"

msgid "Password for {who}: "
msgstr "Κωδικός για {who}: "

msgid "the host key of {host} is not known yet (SHA256:{fp}) — connect once from a terminal to confirm it, or add it to {path}"
msgstr "το κλειδί του {host} δεν είναι ακόμη γνωστό (SHA256:{fp}) — συνδεθείτε μία φορά από τερματικό για να το επιβεβαιώσετε ή προσθέστε το στο {path}"

msgid "{host} has no SFTP, and this connection is SFTP only"
msgstr "το {host} δεν έχει SFTP, και αυτή η σύνδεση είναι μόνο SFTP"

msgid "{who} refused the login. Tried: {tried}. Set a password or key in this connection"
msgstr "το {who} απέρριψε τη σύνδεση. Δοκιμάστηκαν: {tried}. Ορίστε κωδικό ή κλειδί σε αυτή τη σύνδεση"

msgid "{who} refused the login. Tried: {tried}. Set a password or key in this connection, or give --ssh-key / --ssh-password-env"
msgstr "το {who} απέρριψε τη σύνδεση. Δοκιμάστηκαν: {tried}. Ορίστε κωδικό ή κλειδί σε αυτή τη σύνδεση, ή δώστε --ssh-key / --ssh-password-env"

msgid "cannot be tested without the engine"
msgstr "δεν μπορεί να ελεγχθεί χωρίς τη μηχανή"

msgid "test failed"
msgstr "ο έλεγχος απέτυχε"

msgid "SSH {who} port {port}"
msgstr "SSH {who} θύρα {port}"

msgid "dashboard closed ({err}); the copy goes on below"
msgstr "ο πίνακας έκλεισε ({err})· η αντιγραφή συνεχίζεται παρακάτω"

msgid "dashboard: that view could not be drawn ({err}); back to the main view"
msgstr "πίνακας: αυτή η προβολή δεν σχεδιάστηκε ({err})· επιστροφή στην κύρια προβολή"

msgid "the endpoint {endpoint} is not a valid URL — check the endpoint URL (for example https://host:port)"
msgstr "το endpoint {endpoint} δεν είναι έγκυρο URL — ελέγξτε το URL του endpoint (για παράδειγμα https://host:port)"

msgid "Warning: could not read the cookies in {src} for {host} ({why}) — downloading without them"
msgstr "Προειδοποίηση: δεν ήταν δυνατή η ανάγνωση των cookies στο {src} για το {host} ({why}) — λήψη χωρίς αυτά"

msgid "no such file"
msgstr "δεν υπάρχει τέτοιο αρχείο"

msgid "not a cookies.txt file: {err}"
msgstr "δεν είναι αρχείο cookies.txt: {err}"

msgid "this build cannot read a browser's session; export the browser's cookies to a cookies.txt and use --cookies FILE"
msgstr "αυτή η έκδοση δεν διαβάζει συνεδρία φυλλομετρητή· εξαγάγετε τα cookies του φυλλομετρητή σε cookies.txt και χρησιμοποιήστε --cookies FILE"

msgid "browser_cookie3 is not installed: python -m pip install browser-cookie3"
msgstr "το browser_cookie3 δεν είναι εγκατεστημένο: python -m pip install browser-cookie3"

msgid "this build cannot read {src}"
msgstr "αυτή η έκδοση δεν διαβάζει το {src}"

msgid "this site needs sign-in: open it in {browser} and sign in, or set cookies"
msgstr "αυτός ο ιστότοπος θέλει σύνδεση: ανοίξτε τον στο {browser} και συνδεθείτε, ή ορίστε cookies"

msgid "this site needs sign-in: open it in your browser and sign in, then choose it as the live session, or set cookies (--cookies FILE / --cookies-from-browser NAME)"
msgstr "αυτός ο ιστότοπος θέλει σύνδεση: ανοίξτε τον στον φυλλομετρητή σας, συνδεθείτε και επιλέξτε τον ως ζωντανή συνεδρία, ή ορίστε cookies (--cookies FILE / --cookies-from-browser NAME)"

msgid "Dry run…"
msgstr "Δοκιμαστική εκτέλεση…"

msgid "Starting…"
msgstr "Εκκίνηση…"

msgid "copied — waiting for the others"
msgstr "αντιγράφηκε — αναμονή για τα υπόλοιπα"

msgid " and mtime"
msgstr " και ώρα τροποποίησης"

msgid "HTTP → {n} destinations  [one download]"
msgstr "HTTP → {n} προορισμοί  [μία λήψη]"

msgid "SSH transfers require paramiko"
msgstr "οι μεταφορές SSH χρειάζονται το paramiko"

msgid "Up to date — skipped (same size{and_mtime})."
msgstr "Ενημερωμένο — παραλείφθηκε (ίδιο μέγεθος{and_mtime})."

msgid "a web source does not go to a cloud store — relay via an SSH or SMB destination"
msgstr "μια πηγή web δεν πηγαίνει σε αποθήκη cloud — αναμεταδώστε μέσω προορισμού SSH ή SMB"

msgid "no destination is left to write to"
msgstr "δεν απέμεινε προορισμός για εγγραφή"

msgid "transfer truncated"
msgstr "η μεταφορά διακόπηκε πριν το τέλος"

msgid "{path}: {why}"
msgstr "{path}: {why}"

msgid "Write a manifest (MHL)"
msgstr "Εγγραφή manifest (MHL)"

msgid "Drop a destination that stops answering after {n} s"
msgstr "Εγκατάλειψη προορισμού που δεν απαντά για {n} s"

msgid "Verify against manifest"
msgstr "Έλεγχος με βάση το manifest"

msgid "Check a destination against the manifest a copy wrote there, without the source (--verify-manifest)"
msgstr "Έλεγχος ενός προορισμού με βάση το manifest που έγραψε εκεί μια αντιγραφή, χωρίς την πηγή (--verify-manifest)"

msgid "Destination folder"
msgstr "Φάκελος προορισμού"

msgid "Read every file back (--deep)"
msgstr "Ανάγνωση κάθε αρχείου ξανά (--deep)"

msgid "manifest (MHL)"
msgstr "manifest (MHL)"

msgid "no manifest: {why}"
msgstr "χωρίς manifest: {why}"

msgid "The saved connections are locked — the run needs them"
msgstr "Οι αποθηκευμένες συνδέσεις είναι κλειδωμένες — η εκτέλεση τις χρειάζεται"

msgid "{dest}: connecting…"
msgstr "{dest}: σύνδεση…"

msgid "Check cancelled"
msgstr "Ο έλεγχος ακυρώθηκε"

msgid "up to date"
msgstr "ενημερωμένο"

msgid "sample-hashed"
msgstr "δειγματοληπτικός έλεγχος hash"

msgid "--ui dashboard needs blitcp_dashboard.py beside blitcp.py — get it with: blitcp --fetch-modules (lines for now)"
msgstr "το --ui dashboard χρειάζεται το blitcp_dashboard.py δίπλα στο blitcp.py — πάρτε το με: blitcp --fetch-modules (γραμμές προς το παρόν)"

msgid "Write an ASC MHL generation (ascmhl/ and blitcp.xxh128) at each destination whose check found no fault, from the hashes this run already has (a local source, xxh128). What is skipped is decided as without it. Check a destination later, without the source, with --verify-manifest DEST."
msgstr "Γράφει μια γενιά ASC MHL (ascmhl/ και blitcp.xxh128) σε κάθε προορισμό που πέρασε τον έλεγχο, από τα hash που ήδη έχει αυτή η εκτέλεση (τοπική πηγή, xxh128). Το τι παραλείπεται αποφασίζεται όπως και χωρίς αυτό. Έλεγχος ενός προορισμού αργότερα, χωρίς την πηγή: --verify-manifest DEST."
