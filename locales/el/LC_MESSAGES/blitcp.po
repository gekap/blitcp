msgstr "περιμένει το [{k}]"

msgid "writing"
msgstr "γράφει"

msgid "{c} copied · {s} skipped · {l} linked · {f} failed"
msgstr "{c} αντιγράφηκαν · {s} παραλείφθηκαν · {l} συνδέθηκαν · {f} απέτυχαν"

