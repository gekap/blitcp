msgstr "{n} προορισμοί · {ok} ολοκληρώθηκαν · {bad} απέτυχαν"

msgid "{n} duplicates"
msgstr "{n} διπλότυπα"

msgid "{path}: cannot be read ({why}) — ignored"
msgstr "{path}: δεν διαβάζεται ({why}) — αγνοείται"

msgid "{path}: not valid TOML ({why}) — ignored"
msgstr "{path}: μη έγκυρο TOML ({why}) — αγνοείται"

